# Server
PORT=3000

# MongoDB
# Railway usually provides MONGO_URL and MONGO_PUBLIC_URL.
MONGO_PUBLIC_URL=
MONGO_URL=
MONGO_DATABASE=admin
MONGO_AUTH_SOURCE=admin

# Postgres
# Railway usually provides DATABASE_URL and DATABASE_PUBLIC_URL.
DATABASE_PUBLIC_URL=
DATABASE_URL=
POSTGRES_PUBLIC_URL=
POSTGRES_URL=
PGDATABASE=
POSTGRES_DB=
DATABASE_SSL=true
POSTGRES_SSL=true

# MySQL
# Railway usually provides MYSQL_URL and MYSQL_PUBLIC_URL.
MYSQL_PUBLIC_URL=
MYSQL_URL=
MYSQL_DATABASE=
MYSQLDATABASE=
MYSQL_SSL=false

# Railway Bucket / S3-compatible storage
BUCKET_ENDPOINT=https://t3.storageapi.dev
BUCKET_REGION=auto
BUCKET_NAME=
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=

# Compatible aliases if you prefer S3/AWS names
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=
AWS_REGION=
AWS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
